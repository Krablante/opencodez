#!/usr/bin/env node

import path from "path"
import fs from "fs"
import { spawn } from "child_process"
import { fileURLToPath } from "url"

const __dirname = path.dirname(fileURLToPath(import.meta.url))

process.env.OPENCODE_APP_NAME ||= "opencodez"
process.env.OPENCODE_CLI_NAME ||= "opencodez"
process.env.OPENCODEZ ||= "1"
process.env.OPENCODE_DISABLE_AUTOUPDATE ||= "1"

const sourceEntry = path.join(__dirname, "..", "src", "index.ts")
const args =
  !process.env.OPENCODE_BIN_PATH && fs.existsSync(sourceEntry)
    ? ["bun", ["run", "--conditions=browser", sourceEntry, ...process.argv.slice(2)]]
    : [process.execPath, [path.join(__dirname, "opencode"), ...process.argv.slice(2)]]

const child = spawn(args[0], args[1], {
  stdio: "inherit",
  env: process.env,
})

for (const signal of ["SIGINT", "SIGTERM"]) {
  process.on(signal, () => {
    if (!child.killed) child.kill(signal)
  })
}

child.on("exit", (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal)
    return
  }
  process.exit(code ?? 0)
})
